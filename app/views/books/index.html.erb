<div class="container">
  <div class="pt-4">
    <% if @book.errors.any? %>
      <% if @book.errors.count== 1 %> 
        <h2><%= @book.errors.count %> error prohibited this obj from being saved:</h2>
      <% else %>
        <h2><%= @book.errors.count %> errors prohibited this obj from being saved:</h2>
      <% end %>
      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <div class="row">
    <%= render "form", user: @user, new_book: @book %>
    <div class="col-md-8 py-3 ml-4 offset-md-1">
      <div class="p-3">
        <h2>Books</h2>
        <table class="table d-flex table-hover table-inverse">
          <tbody>
            <tr>
              <th class="w-30"></th>
              <th class="w-10">Title</th>
              <th class="w-60">Opinion</th>
            </tr>
            <% @books.each do |book| %>
              <tr>
                <td>
                  <%= link_to user_path(book.user_id) do %>
                    <%= image_tag book.user.get_profile_image(100, 100) %>
                  <% end %>
                </td>
                <td class="mx-0 px-0">
                  <%= link_to book_path(book.id) do %>
                  <%= book.title %>
                  <% end %>
                </td>
                <td><%= book.body %></td>
                <td>
                  <% if book.favorited_by?(current_user) %>
                    <p>
                      <%= link_to book_favorite_path(book.id), method: :delete do %>
                        ♥<%= book.favorites.count %>
                      <% end %>
                    </p>
                    <% else %>
                    <p>
                      <%= link_to book_favorite_path(book.id), method: :post do %>
                        ♡<%= book.favorites.count %>
                      <% end %>
                    </p>
                  <% end %>
                </td>
                <td>コメント数: <%= book.post_comments.count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>
