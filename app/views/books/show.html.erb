<div class="container">
  <div class="row">
    <%= render "form", user: @user, new_book: @new_book %>
    <div class="col-md-8 py-3 ml-4 offset-md-1">
      <div class="p-3">
        <h2>Book detail</h2>
        <hr>
        <div class="row">
          <div class="col-2 ">
              <div class="mx-auto">
                  <%= image_tag @book.user.get_profile_image(100, 100) %>
              </div>
              <div class="mx-auto">
                  <%= link_to user_path(@user.id) do %>
                  <%= @user.name %>
                  <% end %>                
              </div>
          </div>
          <div class="col-3">
              <p>
                <%= link_to book_path(@book.id) do %>
                <%= @book.title %>
                <% end %>                    
              </p>
          </div>
          <div class="col-4">
            <p><%= @book.body %></p>         
          </div>
          <div class="col-2">
            <p>コメント数: <%= @book.post_comments.count %></p>
          </div>
          <% if @user == current_user %>
          <div class="col-1 d-flex">
            <div>
               <%= link_to edit_book_path(@book.id) do %>
                <button type="button" class="btn btn-success mr-4 align-items-center">
                  <p>Edit</p>
                </button>
              <% end %>
            </div>
            <div>
               <%= link_to book_path(@book.id), method: :delete do %>
                <button type="button" class="btn btn-danger align-items-center">
                  <p>Destroy</p>
                </button>
              <% end %>
            </div>
          </div>                
          <% end %>
        </div>
        <div>
          <% @book.post_comments.each do |book_comment| %>
            <p><%= image_tag book_comment.user.get_profile_image(100, 100) %></p>
            <%= book_comment.user.name %>
            <%= book_comment.comment %>
            <% if current_user.id == book_comment.user.id %>
              <%= link_to book_post_comment_path(@book.id, book_comment.id), method: :delete do %>
                <button type="button" class="btn btn-danger align-items-center">
                  <p>Destroy</p>
                </button>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <div>
          <%= form_with model: [@book, @post_comment] do |f| %>
            <%= f.text_area :comment, rows: '5' %>
            <%= f.submit "送信する" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
